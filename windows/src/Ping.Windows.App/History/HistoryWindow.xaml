<Window
    x:Class="Ping.Windows.App.History.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping Rooms">
    <Grid
        x:Name="Root"
        Width="920"
        Height="620"
        Padding="18"
        Background="#121314"
        ColumnSpacing="14">
        <Grid.Resources>
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#24272A" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9DA3AA" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="PingBubbleIncomingBrush" Color="#1B1D20" />
            <SolidColorBrush x:Key="PingBubbleOutgoingBrush" Color="#1F6FEB" />
            <Style x:Key="IncomingBubbleStyle" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="440" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Background" Value="{StaticResource PingBubbleIncomingBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PingIdleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="OutgoingBubbleStyle" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="MaxWidth" Value="440" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Background" Value="{StaticResource PingBubbleOutgoingBrush}" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="Rooms" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource PingMutedBrush}"
                    Text="Recent conversations" />
            </StackPanel>

            <ListView
                x:Name="ConversationsList"
                Grid.Row="1"
                ItemsSource="{Binding Rooms}"
                SelectionChanged="RoomsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="32"
                                Height="32"
                                Background="#334D8CFF"
                                CornerRadius="16">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PingTextBrush}"
                                    Text="{Binding Name}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PingTextBrush}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource PingMutedBrush}"
                                    Text="Open conversation"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="2"
                FontSize="12"
                Foreground="{StaticResource PingMutedBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="RoomHeader" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding SelectedRoomName}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource PingMutedBrush}"
                        Text="Messages and video pings" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="8,4"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
            </Grid>

            <Border
                Grid.Row="1"
                Padding="12"
                Background="{StaticResource PingSurfaceBrush}"
                BorderBrush="{StaticResource PingIdleBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <ListView
                    x:Name="TimelineList"
                    ItemsSource="{Binding Timeline}"
                    DoubleTapped="VideosList_DoubleTapped"
                    SelectionChanged="VideosList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="8">
                                <Border
                                    Style="{StaticResource IncomingBubbleStyle}"
                                    Visibility="{Binding VideoVisibility}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PingTextBrush}"
                                                Text="{Binding Video.SenderNickname}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{StaticResource PingMutedBrush}"
                                                Text="{Binding Video.CaptureMode}" />
                                        </Grid>
                                        <Grid
                                            Width="220"
                                            Height="150"
                                            HorizontalAlignment="Left">
                                            <Border
                                                Background="#22808080"
                                                CornerRadius="12"
                                                Visibility="{Binding Video.ThumbnailPlaceholderVisibility}" />
                                            <Image
                                                Source="{Binding Video.ThumbnailSource}"
                                                Stretch="UniformToFill"
                                                Visibility="{Binding Video.ThumbnailVisibility}" />
                                            <Border
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#AA000000"
                                                CornerRadius="22">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="20"
                                                    Foreground="White"
                                                    Glyph="&#xE768;" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                Padding="6,2"
                                                Click="PlayVideoItemButton_Click"
                                                Content="Play" />
                                            <Button
                                                Padding="6,2"
                                                Click="SaveVideoButton_Click"
                                                Content="Save"
                                                Visibility="{Binding Video.SaveVisibility}" />
                                            <Button
                                                Padding="6,2"
                                                Click="DeleteVideoButton_Click"
                                                Content="Delete" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Video.Reactions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Padding="6,2"
                                                        Click="ReactionButton_Click"
                                                        Content="{Binding Display}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Style="{StaticResource IncomingBubbleStyle}"
                                    Visibility="{Binding ChatVisibility}">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PingTextBrush}" Text="{Binding Chat.SenderNickname}" />
                                        <Border
                                            Padding="8,5"
                                            Background="#16181B"
                                            BorderBrush="{StaticResource PingIdleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding Chat.ReplyPreviewVisibility}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource PingMutedBrush}"
                                                Text="{Binding Chat.ReplyPreview}"
                                                TextWrapping="WrapWholeWords" />
                                        </Border>
                                        <Border
                                            Padding="8"
                                            Background="#1B1D20"
                                            BorderBrush="{StaticResource PingIdleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding Chat.AttachmentVisibility}">
                                            <StackPanel Spacing="5">
                                                <Image
                                                    MaxHeight="120"
                                                    HorizontalAlignment="Left"
                                                    Source="{Binding Chat.ImageSource}"
                                                    Stretch="Uniform"
                                                    Visibility="{Binding Chat.ImageVisibility}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource PingMutedBrush}"
                                                    Text="{Binding Chat.AttachmentStatus}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock
                                            Foreground="{StaticResource PingTextBrush}"
                                            Text="{Binding Chat.Body}"
                                            TextWrapping="WrapWholeWords" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                Padding="6,2"
                                                Click="DeleteChatButton_Click"
                                                Content="Delete"
                                                Visibility="{Binding Chat.DeleteVisibility}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Chat.Reactions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Padding="6,2"
                                                        Click="ReactionButton_Click"
                                                        Content="{Binding Display}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                x:Name="ComposerBar"
                Grid.Row="2"
                Padding="12"
                Background="{StaticResource PingSurfaceBrush}"
                BorderBrush="{StaticResource PingIdleBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <Border
                        Padding="8,6"
                        Background="#1B1D20"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ReplyPreviewVisibility}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource PingMutedBrush}"
                                Text="{Binding ReplyPreviewText}"
                                TextWrapping="WrapWholeWords" />
                            <Button
                                Grid.Column="1"
                                Padding="6,2"
                                Click="CancelReplyButton_Click"
                                Content="Cancel" />
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="SelectedImageText"
                        FontSize="11"
                        Foreground="{StaticResource PingMutedBrush}"
                        TextWrapping="NoWrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AttachButton"
                            Click="AttachImageButton_Click"
                            Content="Attach" />
                        <Button
                            Grid.Column="1"
                            Click="ClearImageButton_Click"
                            Content="Clear" />
                        <TextBox
                            x:Name="ChatBox"
                            Grid.Column="2"
                            MinHeight="34"
                            MaxHeight="86"
                            AcceptsReturn="True"
                            KeyDown="ChatBox_KeyDown"
                            TextWrapping="Wrap"
                            PlaceholderText="Message this room" />
                        <Button
                            x:Name="SendMessageButton"
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Click="SendChatButton_Click"
                            Content="Send" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
