<Window
    x:Class="Ping.Windows.App.History.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping History">
    <Grid
        x:Name="Root"
        Width="820"
        Height="560"
        Padding="18"
        Background="#121314"
        ColumnSpacing="14">
        <Grid.Resources>
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#24272A" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9DA3AA" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#4DFFFFFF" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource PingTextBrush}"
                Text="History" />

            <ListView
                x:Name="RoomsList"
                Grid.Row="1"
                ItemsSource="{Binding Rooms}"
                SelectionChanged="RoomsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Padding="4" Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="2"
                FontSize="12"
                Foreground="{StaticResource PingMutedBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="{Binding SelectedRoomName}" />
                <Button
                    Grid.Column="1"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
                <Button
                    Grid.Column="2"
                    Click="PlayVideoButton_Click"
                    Content="Play selected video" />
            </Grid>

            <Border
                Grid.Row="1"
                Padding="12"
                Background="{StaticResource PingSurfaceBrush}"
                BorderBrush="{StaticResource PingIdleBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ListView
                    x:Name="VideosList"
                    ItemsSource="{Binding Timeline}"
                    DoubleTapped="VideosList_DoubleTapped"
                    SelectionChanged="VideosList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="8">
                                <Grid
                                    ColumnSpacing="8"
                                    Visibility="{Binding VideoVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding Video.SenderNickname}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource PingMutedBrush}"
                                            Text="{Binding Video.VideoId}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                Padding="6,2"
                                                Click="PlayVideoItemButton_Click"
                                                Content="Play" />
                                            <Button
                                                Padding="6,2"
                                                Click="ReplyVideoButton_Click"
                                                Content="Reply" />
                                            <Button
                                                Padding="6,2"
                                                Click="DeleteVideoButton_Click"
                                                Content="Delete" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ItemsControl ItemsSource="{Binding Video.Reactions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Padding="6,2"
                                                            Click="ReactionButton_Click"
                                                            Content="{Binding Display}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Video.QuickReactions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Padding="6,2"
                                                            Click="ReactionButton_Click"
                                                            Content="{Binding Emoji}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource PingMutedBrush}"
                                        Text="{Binding Video.CaptureMode}" />
                                </Grid>

                                <StackPanel
                                    Spacing="5"
                                    Visibility="{Binding ChatVisibility}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Chat.SenderNickname}" />
                                    <Border
                                        Padding="8,5"
                                        Background="#16181B"
                                        BorderBrush="{StaticResource PingIdleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding Chat.ReplyPreviewVisibility}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource PingMutedBrush}"
                                            Text="{Binding Chat.ReplyPreview}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                                    <Border
                                        Padding="8"
                                        Background="#1B1D20"
                                        BorderBrush="{StaticResource PingIdleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding Chat.AttachmentVisibility}">
                                        <StackPanel Spacing="5">
                                            <Image
                                                MaxHeight="96"
                                                HorizontalAlignment="Left"
                                                Source="{Binding Chat.ImageSource}"
                                                Stretch="Uniform"
                                                Visibility="{Binding Chat.ImageVisibility}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource PingMutedBrush}"
                                                Text="{Binding Chat.AttachmentStatus}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Foreground="{StaticResource PingMutedBrush}"
                                        Text="{Binding Chat.Body}"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button
                                            Padding="6,2"
                                            Click="ReplyChatButton_Click"
                                            Content="Reply" />
                                        <Button
                                            Padding="6,2"
                                            Click="DeleteChatButton_Click"
                                            Content="Delete"
                                            Visibility="{Binding Chat.DeleteVisibility}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ItemsControl ItemsSource="{Binding Chat.Reactions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Padding="6,2"
                                                        Click="ReactionButton_Click"
                                                        Content="{Binding Display}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Chat.QuickReactions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Padding="6,2"
                                                        Click="ReactionButton_Click"
                                                        Content="{Binding Emoji}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Grid.Row="2"
                Padding="12"
                Background="{StaticResource PingSurfaceBrush}"
                BorderBrush="{StaticResource PingIdleBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="Reactions" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding Reactions}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Emoji}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{StaticResource PingMutedBrush}"
                                            Text="{Binding TargetKind}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{StaticResource PingMutedBrush}"
                                            Text="{Binding TotalCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="8">
                        <Border
                            Padding="8,6"
                            Background="#1B1D20"
                            BorderBrush="{StaticResource PingIdleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ReplyPreviewVisibility}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource PingMutedBrush}"
                                    Text="{Binding ReplyPreviewText}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    Grid.Column="1"
                                    Padding="6,2"
                                    Click="CancelReplyButton_Click"
                                    Content="Cancel" />
                            </Grid>
                        </Border>
                        <TextBlock
                            x:Name="SelectedImageText"
                            FontSize="11"
                            Foreground="{StaticResource PingMutedBrush}"
                            TextWrapping="NoWrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                Click="AttachImageButton_Click"
                                Content="Attach image" />
                            <Button
                                Click="ClearImageButton_Click"
                                Content="Clear" />
                        </StackPanel>
                        <TextBox
                            x:Name="ChatBox"
                            PlaceholderText="Message this room" />
                        <Button
                            HorizontalAlignment="Right"
                            Click="SendChatButton_Click"
                            Content="Send chat" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
