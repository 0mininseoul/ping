<UserControl x:Class="Ping.Windows.App.History.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:Ping.Windows.App.Setup"
    xmlns:ui="using:Ping.Windows.App.UI">
    <Grid x:Name="Root" Background="{ThemeResource PingBackgroundBrush}" ColumnSpacing="1">
        <Grid.Resources><setup:PositiveIntToVisibilityConverter x:Key="UnreadVisibilityConverter" /></Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid RowSpacing="8" Padding="10,12,10,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="내 룸" Style="{StaticResource PingBodyTextStyle}" FontWeight="SemiBold" Foreground="{ThemeResource PingMutedBrush}" />
                </StackPanel>
                <Button x:Name="SearchRoomsButton" Grid.Column="1" Click="SearchRooms_Click" Style="{StaticResource PingIconButtonStyle}" AutomationProperties.Name="룸 또는 사람 찾기" ToolTipService.ToolTip="룸 · 사람 찾기"><FontIcon Glyph="&#xE721;" FontSize="15" /></Button>
                <Button x:Name="CreateRoomButton" Grid.Column="2" Click="CreateRoom_Click" Style="{StaticResource PingIconButtonStyle}" AutomationProperties.Name="새 룸 만들기" ToolTipService.ToolTip="새 룸 만들기">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                </Button>
            </Grid>
            <Expander x:Name="InvitationsPanel" Grid.Row="1" Header="받은 초대" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="InvitationsItems"><ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,4" Spacing="6">
                            <TextBlock Text="{Binding RoomName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FromNickname}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="수락" Tag="{Binding}" Click="AcceptInvitation_Click" Padding="8,4" FontSize="12" /><Button Content="거절" Tag="{Binding}" Click="RejectInvitation_Click" Padding="8,4" FontSize="12" /></StackPanel>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Expander>
            <ListView x:Name="RoomsList" Grid.Row="2" ItemsSource="{Binding Rooms}" SelectionChanged="RoomsList_SelectionChanged"
                SelectionMode="Single" AutomationProperties.Name="대화방" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,6" ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PingBodyTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MemberCountLabel}" Foreground="{ThemeResource PingMutedBrush}" Style="{StaticResource PingCaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="7,3" CornerRadius="10" Background="{ThemeResource PingAccentBrush}"
                                VerticalAlignment="Center" Visibility="{Binding UnreadCount, Converter={StaticResource UnreadVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadCount}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingBackgroundBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="3" Spacing="10">
                <Border Padding="4,6">
                    <StackPanel Spacing="4">
                        <TextBlock Text="기본 전송 대상" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" />
                        <TextBlock x:Name="DefaultRoomText" Text="방을 선택해 주세요" Style="{StaticResource PingBodyTextStyle}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PingTextBrush}" />
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="HotkeyHint" Text="Alt+P 얼굴 · Alt+L 화면" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Click="OpenSettings_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="설정" AutomationProperties.Name="설정">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid x:Name="ConversationSurface" Grid.Column="1" RowSpacing="0" Background="{ThemeResource PingSurfaceBrush}"
            AllowDrop="True" DragOver="Conversation_DragOver" DragLeave="Conversation_DragLeave" Drop="Conversation_Drop">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="4" Padding="16,10" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SelectedRoomName}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PingTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedRoom.MemberCountLabel}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" />
                </StackPanel>
                <Button x:Name="MembersButton" Grid.Column="1" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="룸 멤버" AutomationProperties.Name="룸 멤버">
                    <FontIcon Glyph="&#xE716;" FontSize="16" />
                    <Button.Flyout><Flyout x:Name="MembersFlyout" Opening="MembersFlyout_Opening">
                        <StackPanel Width="240" Spacing="12">
                            <TextBlock x:Name="MembersTitle" Text="멤버" Style="{StaticResource PingBodyTextStyle}" FontWeight="SemiBold" />
                            <ItemsControl x:Name="MembersItems"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,5" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource PingReceivedBubbleBrush}"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Nickname}" Style="{StaticResource PingBodyTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Role}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Button Content="사람 초대" Click="InvitePeople_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Flyout></Button.Flyout>
                </Button>
                <Button x:Name="InviteLinkButton" Grid.Column="2" Click="CopyInviteLink_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="초대 링크 복사" AutomationProperties.Name="초대 링크 복사"><FontIcon Glyph="&#xE71B;" FontSize="16" /></Button>
                <Button x:Name="RenameRoomButton" Grid.Column="3" Click="RenameRoom_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="룸 이름 변경" AutomationProperties.Name="룸 이름 변경"><FontIcon Glyph="&#xE70F;" FontSize="16" /></Button>
                <Button x:Name="LeaveRoomButton" Grid.Column="4" Click="LeaveRoom_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="룸 나가기" AutomationProperties.Name="룸 나가기"><SymbolIcon Symbol="LeaveChat" /></Button>
            </Grid>
            <Border x:Name="ConnectionBanner" Grid.Row="1" Padding="12,8" CornerRadius="12" Background="{ThemeResource PingWarningFillBrush}" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConnectionText" Foreground="{ThemeResource PingTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetryButton" Grid.Column="1" Content="다시 연결" Click="Retry_Click" Visibility="Collapsed" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Padding="12,8" Background="{ThemeResource PingSurfaceBrush}">
                <Grid>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="320">
                        <FontIcon Glyph="&#xE8F2;" FontSize="38" Foreground="{ThemeResource PingAccentBrush}" />
                        <TextBlock x:Name="EmptyTitle" Text="대화를 시작하세요" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource PingTextBrush}" />
                        <TextBlock x:Name="EmptyDetail" Text="방을 만들거나 참여한 뒤 메시지와 3초 영상을 주고받으세요." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource PingMutedBrush}" />
                        <Button x:Name="EmptyRoomButton" Content="룸 · 사람 찾기" Click="SearchRooms_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="VideosList" ItemsSource="{Binding Timeline}" Visibility="{Binding TimelineVisibility}"
                        SelectionChanged="VideosList_SelectionChanged" DoubleTapped="VideosList_DoubleTapped" KeyDown="Timeline_KeyDown"
                        ItemContainerStyle="{StaticResource PingTimelineItemStyle}" Background="Transparent" AutomationProperties.Name="메시지 타임라인">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding DayHeading}" Visibility="{Binding DayHeadingVisibility}" HorizontalAlignment="Center" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" Margin="0,8" />
                                    <StackPanel HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="280" Spacing="2" ToolTipService.ToolTip="{Binding TimeLabel}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SenderLabel}" Visibility="{Binding SenderVisibility}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" />
                                        </Grid>
                                        <Border>
                                            <Grid>
                                                <StackPanel Spacing="8" Visibility="{Binding VideoVisibility}">
                                                    <StackPanel.ContextFlyout>
                                                        <MenuFlyout Opening="MessageMenu_Opening">
                                                            <MenuFlyoutItem Text="다시 재생" Click="PlayVideoItemButton_Click" />
                                                            <MenuFlyoutItem Text="답장" Click="ReplyVideoButton_Click" />
                                                            <MenuFlyoutSubItem Text="반응">
                                                                <MenuFlyoutItem Text="❤️" Tag="❤️" Click="ContextReaction_Click" /><MenuFlyoutItem Text="👍" Tag="👍" Click="ContextReaction_Click" />
                                                                <MenuFlyoutItem Text="👎" Tag="👎" Click="ContextReaction_Click" /><MenuFlyoutItem Text="😂" Tag="😂" Click="ContextReaction_Click" />
                                                                <MenuFlyoutItem Text="‼️" Tag="‼️" Click="ContextReaction_Click" /><MenuFlyoutItem Text="❓" Tag="❓" Click="ContextReaction_Click" />
                                                            </MenuFlyoutSubItem>
                                                            <MenuFlyoutSeparator /><MenuFlyoutItem Text="영상 저장" Click="SaveVideoButton_Click" Visibility="{Binding Video.SaveVisibility}" />
                                                            <MenuFlyoutItem Text="{Binding Video.RemovalLabel}" Click="DeleteVideoButton_Click" Visibility="{Binding Video.DeleteVisibility}" />
                                                        </MenuFlyout>
                                                    </StackPanel.ContextFlyout>
                                                    <Button Click="PlayVideoItemButton_Click" Visibility="{Binding Video.PreviewVisibility}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="영상 재생">
                                                        <Grid Width="{Binding Video.ThumbnailWidth}" Height="{Binding Video.ThumbnailHeight}" Loaded="VideoThumbnail_Loaded" SizeChanged="VideoThumbnail_SizeChanged">
                                                            <Border Background="{ThemeResource PingReceivedBubbleBrush}" CornerRadius="8"><FontIcon Glyph="&#xE714;" Foreground="{ThemeResource PingMutedBrush}" FontSize="20" /></Border>
                                                            <Image Source="{Binding Video.ThumbnailSource}" Stretch="UniformToFill" Visibility="{Binding Video.ThumbnailVisibility}" />
                                                        </Grid>
                                                    </Button>
                                                    <ContentControl x:Name="InlineFaceHost" Visibility="{Binding Video.InlineVisibility}" HorizontalContentAlignment="Left"
                                                        Loaded="InlineHost_Loaded" Unloaded="InlineHost_Unloaded" DataContextChanged="InlineHost_DataContextChanged" />
                                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1" Text="{Binding Video.AutoReplyLabel}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Video.Reactions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Display}" Click="ReactionButton_Click" Padding="6,2" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Spacing="8" Visibility="{Binding ChatVisibility}">
                                                    <StackPanel.ContextFlyout>
                                                        <MenuFlyout Opening="MessageMenu_Opening">
                                                            <MenuFlyoutItem Text="답장" Click="ReplyChatButton_Click" /><MenuFlyoutItem Text="텍스트 복사" Click="CopyChat_Click" />
                                                            <MenuFlyoutSubItem Text="반응">
                                                                <MenuFlyoutItem Text="❤️" Tag="❤️" Click="ContextReaction_Click" /><MenuFlyoutItem Text="👍" Tag="👍" Click="ContextReaction_Click" />
                                                                <MenuFlyoutItem Text="👎" Tag="👎" Click="ContextReaction_Click" /><MenuFlyoutItem Text="😂" Tag="😂" Click="ContextReaction_Click" />
                                                                <MenuFlyoutItem Text="‼️" Tag="‼️" Click="ContextReaction_Click" /><MenuFlyoutItem Text="❓" Tag="❓" Click="ContextReaction_Click" />
                                                            </MenuFlyoutSubItem>
                                                            <MenuFlyoutSeparator /><MenuFlyoutItem Text="모두에게서 삭제" Click="DeleteChatButton_Click" Visibility="{Binding Chat.DeleteVisibility}" />
                                                        </MenuFlyout>
                                                    </StackPanel.ContextFlyout>
                                                    <TextBlock Text="{Binding Chat.ReplyPreview}" Visibility="{Binding Chat.ReplyPreviewVisibility}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" TextWrapping="Wrap" />
                                                    <ui:MessageBubble IsMine="{Binding IsMine}" Visibility="{Binding Chat.BodyVisibility}" Style="{StaticResource PingMessageBubbleStyle}" Padding="11,6" CornerRadius="14" HorizontalContentAlignment="Stretch"
                                                        SentFill="{ThemeResource PingSentBubbleBrush}" ReceivedFill="{ThemeResource PingReceivedBubbleBrush}"
                                                        SentText="{ThemeResource PingSentTextBrush}" ReceivedText="{ThemeResource PingTextBrush}">
                                                        <TextBlock Text="{Binding Chat.Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PingBodyTextStyle}" />
                                                    </ui:MessageBubble>
                                                    <StackPanel Visibility="{Binding Chat.AttachmentVisibility}" Spacing="4">
                                                        <Button x:Name="PhotoButton" Click="ShowPhotoPreview_Click" IsEnabled="{Binding Chat.CanPreviewImage}" Visibility="{Binding Chat.ImageVisibility}"
                                                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" AutomationProperties.Name="사진 크게 보기" ToolTipService.ToolTip="사진 크게 보기">
                                                            <Border Width="{Binding Chat.ImageWidth}" Height="{Binding Chat.ImageHeight}" CornerRadius="14" Background="{ThemeResource PingReceivedBubbleBrush}" Loaded="PhotoTile_Loaded" SizeChanged="PhotoTile_SizeChanged">
                                                                <Image Source="{Binding Chat.ImageSource}" Stretch="Uniform" />
                                                            </Border>
                                                        </Button>
                                                        <TextBlock Text="{Binding Chat.AttachmentStatus}" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Click="OpenChatLinkButton_Click" Visibility="{Binding Chat.LinkPreviewVisibility}" HorizontalContentAlignment="Stretch" MaxWidth="320">
                                                        <StackPanel Spacing="5">
                                                            <Image Source="{Binding Chat.LinkPreviewImageSource}" Visibility="{Binding Chat.LinkPreviewImageVisibility}" MaxHeight="140" Stretch="UniformToFill" />
                                                            <TextBlock Text="{Binding Chat.LinkPreviewHost}" Style="{StaticResource PingCaptionTextStyle}" />
                                                            <TextBlock Text="{Binding Chat.LinkPreviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Chat.LinkPreviewSummary}" Visibility="{Binding Chat.LinkPreviewSummaryVisibility}" Style="{StaticResource PingCaptionTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                                                        </StackPanel>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Chat.Reactions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Display}" Click="ReactionButton_Click" Padding="6,2" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Row="3" Padding="12,8" Background="{ThemeResource PingBackgroundBrush}" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="0,1,0,0">
                <ContentControl IsEnabled="{Binding CanCompose}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Grid Visibility="{Binding ReplyPreviewVisibility}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ReplyPreviewText}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource PingMutedBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="CancelReplyButton_Click" Content="×" Padding="6,0" AutomationProperties.Name="답장 취소" />
                    </Grid>
                    <Grid x:Name="AttachmentPreview" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource PingReceivedBubbleBrush}" Margin="0,0,10,0">
                            <Image x:Name="DraftPhotoImage" Stretch="Uniform" AutomationProperties.Name="첨부할 사진" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="SelectedImageText" Text="{Binding DraftImageName}" FontSize="12" Foreground="{ThemeResource PingTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Enter로 사진과 메시지 보내기" FontSize="12" Foreground="{ThemeResource PingMutedBrush}" />
                        </StackPanel>
                        <Button x:Name="ClearImageButton" Grid.Column="2" Click="ClearImageButton_Click" Content="×" Padding="6,0" AutomationProperties.Name="사진 첨부 취소" />
                    </Grid>
                    <TextBlock x:Name="ImageInputStatus" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PingCaptionTextStyle}" Foreground="{ThemeResource PingMutedBrush}" AutomationProperties.LiveSetting="Polite" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="ComposeMenuButton" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="사진 · 영상 보내기" AutomationProperties.Name="사진과 영상 보내기" VerticalAlignment="Bottom"><FontIcon Glyph="&#xE710;" FontSize="18" />
                            <Button.Flyout><MenuFlyout>
                                <MenuFlyoutItem Text="사진 첨부" Click="AttachImageButton_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Pictures" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="사진 붙여넣기 (Ctrl+V)" Click="PastePhoto_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Paste" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="얼굴 핑 (Alt+P)" Click="FacePing_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Camera" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="화면 + 얼굴 (Alt+L)" Click="ScreenPing_Click" />
                                <MenuFlyoutSeparator /><MenuFlyoutItem Text="대화 새로고침" Click="RefreshButton_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout></Button.Flyout>
                        </Button>
                        <TextBox x:Name="ChatBox" Grid.Column="1" Text="{Binding DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                            TextWrapping="Wrap" MinHeight="36" MaxHeight="120" PlaceholderText="메시지 입력…" PreviewKeyDown="ChatBox_KeyDown" KeyUp="ChatBox_KeyUp" MaxLength="2000"
                            TextCompositionStarted="ChatCompositionStarted" TextCompositionEnded="ChatCompositionEnded" Paste="ChatBox_Paste" AutomationProperties.Name="메시지 입력"
                            BorderThickness="1" BorderBrush="{ThemeResource PingIdleBrush}" CornerRadius="16" Background="{ThemeResource PingInputBrush}" FontSize="{StaticResource PingBodyFontSize}" Padding="12,8" />
                        <Button x:Name="SendButton" Grid.Column="2" Click="SendChatButton_Click" IsEnabled="{Binding CanSend}" Style="{StaticResource PingIconButtonStyle}"
                            AutomationProperties.Name="메시지 전송" ToolTipService.ToolTip="전송 (Enter)" VerticalAlignment="Bottom"><FontIcon Glyph="&#xE724;" FontSize="18" /></Button>
                    </Grid>
                </StackPanel>
                </ContentControl>
            </Border>
            <Border x:Name="ImageDropOverlay" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False" Margin="10" CornerRadius="16"
                BorderThickness="2" BorderBrush="{ThemeResource PingAccentBrush}" Background="{ThemeResource PingAccentFillBrush}">
                <TextBlock Text="사진을 놓아 첨부하기" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PingTextBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
