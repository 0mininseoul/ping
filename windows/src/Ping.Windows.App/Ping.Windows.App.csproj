<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <RootNamespace>Ping.Windows.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ping.Windows.Core\Ping.Windows.Core.csproj" />
    <ProjectReference
      Include="..\Ping.Windows.NativeCapture\Ping.Windows.NativeCapture.vcxproj"
      ReferenceOutputAssembly="false"
      Properties="Configuration=$(Configuration);Platform=$(Platform);OutDir=$(OutDir)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    Supabase.json holds the shared backend URL + public anon key and is bundled
    into the MSIX so a freshly installed Ping works with zero manual setup.
    The real file is git-ignored and written by CI from repository secrets
    (PING_SUPABASE_URL / PING_SUPABASE_ANON_KEY). When it is absent (e.g. local
    dev), the build still succeeds and the app falls back to the user override at
    %LOCALAPPDATA%\Ping\Supabase.json. See Supabase.example.json for the format.
  -->
  <ItemGroup Condition="Exists('Supabase.json')">
    <Content Include="Supabase.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyNativeCaptureDllToOutput" AfterTargets="Build">
    <PropertyGroup>
      <NativeCaptureDllPath>$(MSBuildThisFileDirectory)..\Ping.Windows.NativeCapture\bin\$(Platform)\$(Configuration)\$(TargetFramework)\Ping.Windows.NativeCapture.dll</NativeCaptureDllPath>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(NativeCaptureDllPath)')"
      Text="Native capture DLL was not built: $(NativeCaptureDllPath)" />
    <Copy
      SourceFiles="$(NativeCaptureDllPath)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>
  <Target
    Name="AddNativeCaptureDllToAppxPackage"
    DependsOnTargets="CopyNativeCaptureDllToOutput"
    BeforeTargets="_ComputeAppxPackagePayload">
    <ItemGroup>
      <AppxPackagePayload Include="$(OutDir)Ping.Windows.NativeCapture.dll">
        <TargetPath>Ping.Windows.NativeCapture.dll</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>
</Project>
