<Window
    x:Class="Ping.Windows.App.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:onboarding="using:Ping.Windows.App.Onboarding">
    <Window.Resources>
        <onboarding:OnboardingViewModel x:Key="OnboardingViewModel" />
    </Window.Resources>

    <Grid
        Width="560"
        Padding="24"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DataContext="{StaticResource OnboardingViewModel}"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Set up Ping" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Check Windows, capture, notifications, hotkeys, and startup." />
        </StackPanel>

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{Binding Rows}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        MinHeight="72"
                        Padding="0,10"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Title}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Status}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Message}"
                            TextWrapping="WrapWholeWords" />

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Content="Retry"
                            IsEnabled="{Binding CanRetry}" />

                        <Button
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Content="{Binding PrimaryAction.Label}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Screen+face quick send is enabled only when Windows 11 24H2+, screen capture, and hotkeys are ready."
            TextWrapping="WrapWholeWords" />
    </Grid>
</Window>
