<UserControl x:Class="Ping.Windows.App.Setup.RoomConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" MinWidth="420" Height="420" RowSpacing="12">
        <Grid.Resources><Style x:Key="SearchResultItemStyle" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="12,6" CornerRadius="22" Background="{ThemeResource PingInputBrush}" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource PingMutedBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" PlaceholderText="룸 또는 닉네임 검색" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="QueryChanged" KeyDown="SearchKeyDown" AutomationProperties.Name="룸 또는 닉네임 검색" />
                <Button x:Name="SearchButton" Grid.Column="2" Click="SearchNow" Style="{StaticResource PingIconButtonStyle}" AutomationProperties.Name="검색" ToolTipService.ToolTip="검색"><FontIcon Glyph="&#xE721;" FontSize="16" /></Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="12,6" CornerRadius="22" Background="{ThemeResource PingInputBrush}" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{ThemeResource PingMutedBrush}" />
                <TextBox x:Name="InviteLinkBox" Grid.Column="1" PlaceholderText="초대 링크 또는 코드" TextChanged="InviteLinkChanged" KeyDown="InviteLinkKeyDown" BorderThickness="0" Background="Transparent" AutomationProperties.Name="초대 링크 또는 코드" />
                <Button x:Name="JoinLinkButton" Grid.Column="2" Content="참여" Click="JoinLink" IsEnabled="False" AutomationProperties.Name="초대 링크로 참여" />
            </Grid>
        </Border>
        <TextBlock x:Name="SearchError" Grid.Row="2" Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource PingMutedBrush}" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="3">
            <Pivot x:Name="ResultsTabs" SelectionChanged="TabChanged">
                <Pivot.HeaderTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" /></DataTemplate></Pivot.HeaderTemplate>
                <PivotItem Header="룸">
                    <ListView x:Name="RoomResultsList" ItemsSource="{Binding RoomResults}" SelectionMode="None" Padding="0" ItemContainerStyle="{StaticResource SearchResultItemStyle}" Background="Transparent" AutomationProperties.Name="검색한 룸">
                        <ListView.ItemTemplate><DataTemplate>
                            <Border Padding="12" Margin="0,3" CornerRadius="18" Background="{ThemeResource PingBackgroundBrush}" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="{ThemeResource PingMutedBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OwnerNicknameLabel}" FontSize="11" Foreground="{ThemeResource PingMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ActionLabel}" IsEnabled="{Binding CanJoin}" Tag="{Binding}" Click="JoinRoom" VerticalAlignment="Center" AutomationProperties.Name="룸 참여 요청" />
                                </Grid>
                            </Border>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
                <PivotItem Header="사람">
                    <ListView x:Name="UserResultsList" ItemsSource="{Binding UserResults}" SelectionMode="None" Padding="0" ItemContainerStyle="{StaticResource SearchResultItemStyle}" Background="Transparent" AutomationProperties.Name="검색한 사람">
                        <ListView.ItemTemplate><DataTemplate>
                            <Border Padding="12" Margin="0,3" CornerRadius="18" Background="{ThemeResource PingBackgroundBrush}" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource PingMutedBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Nickname}" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding RoomsLabel}" FontSize="11" Foreground="{ThemeResource PingMutedBrush}" /></StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ActionLabel}" IsEnabled="{Binding CanInvite}" Tag="{Binding}" Click="InviteUser" VerticalAlignment="Center" AutomationProperties.Name="사용자 초대" />
                                </Grid>
                            </Border>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
            <TextBlock x:Name="EmptyResults" Text="검색어를 입력하세요" FontSize="13" Foreground="{ThemeResource PingMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <ProgressRing Width="24" Height="24" IsActive="{Binding IsSearching}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10" />
        </Grid>
        <TextBlock x:Name="OperationStatus" Grid.Row="4" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource PingMutedBrush}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
