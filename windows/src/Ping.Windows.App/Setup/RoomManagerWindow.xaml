<Window
    x:Class="Ping.Windows.App.Setup.RoomManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:Ping.Windows.App.Setup"
    Title="Ping Rooms">
    <Grid
        x:Name="Root"
        Width="760"
        Height="540"
        Padding="18"
        Background="#121314"
        ColumnSpacing="14">
        <Grid.Resources>
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#24272A" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9DA3AA" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#4DFFFFFF" />
            <setup:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="Rooms" />
                <Button
                    Grid.Column="1"
                    Click="MoveUpRoomButton_Click"
                    Content="Up"
                    IsEnabled="{Binding CanMoveSelectedRoomUp}" />
                <Button
                    Grid.Column="2"
                    Click="MoveDownRoomButton_Click"
                    Content="Down"
                    IsEnabled="{Binding CanMoveSelectedRoomDown}" />
            </Grid>

            <ListView
                x:Name="RoomsList"
                Grid.Row="1"
                ItemsSource="{Binding Rooms}"
                SelectionChanged="HandleRoomSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource PingMutedBrush}"
                                    Text="{Binding Status}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                MinWidth="22"
                                Height="22"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="#FF3B30"
                                CornerRadius="11"
                                Visibility="{Binding UnreadCount, Converter={StaticResource PositiveIntToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding UnreadCount}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="2"
                FontSize="12"
                Foreground="{StaticResource PingMutedBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="14">
                <Border
                    Padding="14"
                    Background="{StaticResource PingSurfaceBrush}"
                    BorderBrush="{StaticResource PingIdleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="{Binding SelectedRoomName}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource PingMutedBrush}"
                            Text="{Binding SelectedRoomMembers}"
                            TextWrapping="WrapWholeWords" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="RenameRoomBox"
                                PlaceholderText="Rename selected room" />
                            <Button
                                Grid.Column="1"
                                Click="RenameRoomButton_Click"
                                Content="Rename" />
                            <Button
                                Grid.Column="2"
                                Click="LeaveRoomButton_Click"
                                Content="Leave" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="14"
                        Background="{StaticResource PingSurfaceBrush}"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Create and invite" />
                            <TextBox
                                x:Name="NewRoomNameBox"
                                PlaceholderText="Room name" />
                            <TextBox
                                x:Name="InviteUserIdBox"
                                PlaceholderText="User id to invite" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="CreateRoomButton_Click"
                                    Content="Create" />
                                <Button
                                    Click="InviteUserButton_Click"
                                    Content="Invite" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="UserSearchBox"
                                    PlaceholderText="Search user nickname" />
                                <Button
                                    Grid.Column="1"
                                    Click="SearchUsersButton_Click"
                                    Content="Search users" />
                            </Grid>
                            <ListView
                                x:Name="UserSearchResultsList"
                                Height="96"
                                ItemsSource="{Binding UserSearchResults}"
                                SelectionChanged="HandleUserSearchSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Nickname}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource PingMutedBrush}"
                                                Text="{Binding Id}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button
                                HorizontalAlignment="Right"
                                Click="InviteSelectedUserButton_Click"
                                Content="Invite selected user" />
                            <TextBox
                                x:Name="InviteLinkTokenBox"
                                PlaceholderText="Invite link or token" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="CreateInviteLinkButton_Click"
                                    Content="Create link" />
                                <Button
                                    Click="AcceptInviteLinkButton_Click"
                                    Content="Accept link" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="14"
                        Background="{StaticResource PingSurfaceBrush}"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Search open rooms" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="SearchBox"
                                    PlaceholderText="Search" />
                                <Button
                                    Grid.Column="1"
                                    Click="SearchButton_Click"
                                    Content="Search" />
                            </Grid>
                            <ListView
                                x:Name="SearchResultsList"
                                Height="128"
                                ItemsSource="{Binding SearchResults}"
                                SelectionChanged="HandleSearchSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource PingMutedBrush}"
                                                Text="{Binding Status}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button
                                HorizontalAlignment="Right"
                                Click="JoinRoomButton_Click"
                                Content="Join selected" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Padding="14"
                    Background="{StaticResource PingSurfaceBrush}"
                    BorderBrush="{StaticResource PingIdleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="Invitations" />
                        <ListView
                            x:Name="InvitationsList"
                            Height="120"
                            ItemsSource="{Binding Invitations}"
                            SelectionChanged="HandleInvitationSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoomName}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="AcceptInvitationButton_Click"
                                Content="Accept" />
                            <Button
                                Click="RejectInvitationButton_Click"
                                Content="Reject" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
