<Window x:Class="Ping.Windows.App.Setup.RoomManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:Ping.Windows.App.Setup" Title="내 룸">
    <Grid x:Name="Root" Background="{ThemeResource PingBackgroundBrush}" ColumnSpacing="1">
        <Grid.Resources><setup:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" /></Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Padding="10,12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="내 룸" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PingMutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="NewRoomButton" Grid.Column="1" Click="CreateRoomButton_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="새 룸 만들기" AutomationProperties.Name="새 룸 만들기"><FontIcon Glyph="&#xE710;" FontSize="16" /></Button>
            </Grid>
            <ListView x:Name="RoomsList" Grid.Row="1" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" SelectionChanged="HandleRoomSelectionChanged" SelectionMode="Single" Background="Transparent" AutomationProperties.Name="내 룸">
                <ListView.ItemTemplate><DataTemplate>
                    <Grid Padding="2,6" ColumnSpacing="6">
                        <Grid.ContextFlyout><MenuFlyout>
                            <MenuFlyoutItem Text="위로 이동" Tag="{Binding}" Click="MoveUpRoomButton_Click" />
                            <MenuFlyoutItem Text="아래로 이동" Tag="{Binding}" Click="MoveDownRoomButton_Click" />
                        </MenuFlyout></Grid.ContextFlyout>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding MemberCountLabel}" FontSize="11" Foreground="{ThemeResource PingMutedBrush}" /></StackPanel>
                        <Border Grid.Column="1" Padding="6,2" CornerRadius="10" VerticalAlignment="Center" Background="{ThemeResource PingAccentBrush}" Visibility="{Binding UnreadCount, Converter={StaticResource PositiveIntToVisibilityConverter}}">
                            <TextBlock Text="{Binding UnreadCount}" FontSize="11" Foreground="{ThemeResource PingSentTextBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource PingMutedBrush}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Pivot Grid.Column="1" Background="{ThemeResource PingSurfaceBrush}">
            <Pivot.HeaderTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" /></DataTemplate></Pivot.HeaderTemplate>
            <PivotItem Header="룸">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="16,10" ColumnSpacing="4" BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRoomName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedRoom.MemberCountLabel}" FontSize="11" Foreground="{ThemeResource PingMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="CreateInviteLinkButton_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="초대 링크 복사" AutomationProperties.Name="초대 링크 복사"><FontIcon Glyph="&#xE71B;" FontSize="16" /></Button>
                        <Button x:Name="RenameRoomButton" Grid.Column="2" Click="RenameRoomButton_Click" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="룸 이름 변경" AutomationProperties.Name="룸 이름 변경"><FontIcon Glyph="&#xE70F;" FontSize="16" /></Button>
                        <Button x:Name="LeaveRoomButton" Grid.Column="3" Click="LeaveRoomButton_Click" Content="나가기" FontSize="12" Style="{StaticResource PingIconButtonStyle}" ToolTipService.ToolTip="룸 나가기" AutomationProperties.Name="룸 나가기" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"><StackPanel Padding="16,20" Spacing="12">
                        <TextBlock Text="멤버" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PingMutedBrush}" />
                        <ItemsControl ItemsSource="{Binding SelectedRoom.MemberNicknames.Values}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Padding="0,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource PingReceivedBubbleBrush}"><FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource PingMutedBrush}" /></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel></ScrollViewer>
                </Grid>
            </PivotItem>
            <PivotItem Header="찾기">
                <ScrollViewer><StackPanel Spacing="16" Padding="16,8,16,20">
                    <TextBlock Text="열린 룸 찾기" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="룸 이름 검색" AutomationProperties.Name="룸 검색" />
                        <Button Grid.Column="1" Click="SearchButton_Click" Content="검색" />
                    </Grid>
                    <ListView x:Name="SearchResultsList" Height="180" ItemsSource="{Binding SearchResults}" SelectionChanged="HandleSearchSelectionChanged" AutomationProperties.Name="검색한 룸">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OwnerNicknameLabel}" FontSize="11" Foreground="{ThemeResource PingMutedBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Button Click="JoinRoomButton_Click" Content="선택한 룸 참여" HorizontalAlignment="Right" />
                    <Border BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="초대 링크로 참여" FontSize="14" FontWeight="SemiBold" />
                            <TextBox x:Name="InviteLinkTokenBox" PlaceholderText="초대 링크 붙여넣기" AutomationProperties.Name="초대 링크" />
                            <Button Click="AcceptInviteLinkButton_Click" Content="참여" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </PivotItem>
            <PivotItem Header="초대">
                <ScrollViewer><StackPanel Spacing="16" Padding="16,8,16,20">
                    <TextBlock Text="닉네임으로 사람 찾기" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="UserSearchBox" PlaceholderText="닉네임 검색" AutomationProperties.Name="사용자 닉네임 검색" />
                        <Button Grid.Column="1" Click="SearchUsersButton_Click" Content="검색" />
                    </Grid>
                    <ListView x:Name="UserSearchResultsList" Height="150" ItemsSource="{Binding UserSearchResults}" SelectionChanged="HandleUserSearchSelectionChanged" AutomationProperties.Name="검색한 사람">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Nickname}" Padding="4,8" TextTrimming="CharacterEllipsis" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Button Click="InviteSelectedUserButton_Click" Content="선택한 사람 초대" HorizontalAlignment="Right" />
                    <Border BorderBrush="{ThemeResource PingIdleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="받은 초대" FontSize="14" FontWeight="SemiBold" />
                            <ListView x:Name="InvitationsList" Height="120" ItemsSource="{Binding Invitations}" SelectionChanged="HandleInvitationSelectionChanged" AutomationProperties.Name="받은 룸 초대">
                                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding RoomName}" Padding="4,8" /></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="AcceptInvitationButton_Click" Content="수락" />
                                <Button Click="RejectInvitationButton_Click" Content="거절" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Window>
