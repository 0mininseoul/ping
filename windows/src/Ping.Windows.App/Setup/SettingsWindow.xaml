<Window
    x:Class="Ping.Windows.App.Setup.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping Settings">
    <Grid
        x:Name="Root"
        Width="760"
        Height="480"
        Padding="18"
        Background="#121314">
        <Grid.Resources>
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#24272A" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9DA3AA" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#4DFFFFFF" />
        </Grid.Resources>

        <TabView IsAddTabButtonVisible="False">
            <TabViewItem Header="General">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="General" />
                    <TextBox
                        Header="Nickname"
                        IsReadOnly="True"
                        Text="{Binding Nickname}" />
                    <ToggleSwitch
                        Header="화면+얼굴 빠른 전송"
                        IsOn="{Binding IsQuickSendEnabled, Mode=TwoWay}"
                        OffContent="Alt+Shift+L opens mirror"
                        OnContent="Alt+Shift+L records immediately" />
                    <ToggleSwitch
                        Header="Start Ping with Windows"
                        IsEnabled="{Binding CanToggleStartup}"
                        IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                        OffContent="{Binding StartupStatus}"
                        OnContent="{Binding StartupStatus}" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Hotkeys">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="Hotkeys" />
                    <ListView
                        MaxHeight="310"
                        ItemsSource="{Binding HotkeyRows}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="0,8"
                                    ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource PingTextBrush}"
                                        Text="{Binding Label}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        Content="Ctrl"
                                        IsChecked="{Binding IsControl, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="2"
                                        Content="Alt"
                                        IsChecked="{Binding IsAlt, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="3"
                                        Content="Shift"
                                        IsChecked="{Binding IsShift, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="4"
                                        Content="Win"
                                        IsChecked="{Binding IsWindows, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="5"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding KeyChoices}"
                                        SelectedItem="{Binding SelectedKey, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="6"
                                        HorizontalAlignment="Stretch"
                                        Click="ApplyHotkeyButton_Click"
                                        Content="Apply" />
                                    <TextBlock
                                        Grid.Column="7"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource PingMutedBrush}"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Foreground="{StaticResource PingMutedBrush}" Text="{Binding FaceHotkey}" />
                    <TextBlock Foreground="{StaticResource PingMutedBrush}" Text="{Binding ScreenFaceHotkey}" />
                    <TextBlock Foreground="{StaticResource PingMutedBrush}" Text="{Binding QuickSendHotkey}" />
                    <TextBlock Foreground="{StaticResource PingMutedBrush}" Text="{Binding HistoryHotkey}" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Rooms">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="Rooms" />
                    <TextBlock
                        Foreground="{StaticResource PingMutedBrush}"
                        Text="Use the Rooms window to create rooms, invite users, and accept invite links."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="OpenRoomsButton_Click"
                        Content="Open Rooms" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Storage">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="Storage" />
                    <ToggleSwitch
                        Header="Save sent copies"
                        IsOn="{Binding SaveSentCopy, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <ToggleSwitch
                        Header="Allow recipients to save my videos"
                        IsOn="{Binding AllowsLocalSave, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </StackPanel>
            </TabViewItem>

            <TabViewItem Header="Info">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="Ping for Windows" />
                    <TextBlock Foreground="{StaticResource PingMutedBrush}" Text="Windows 11 24H2+" />
                    <TextBlock Foreground="{StaticResource PingMutedBrush}" Text="Updates are handled by the Windows package channel." />
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
