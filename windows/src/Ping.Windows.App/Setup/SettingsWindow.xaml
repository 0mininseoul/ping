<Window
    x:Class="Ping.Windows.App.Setup.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="설정">
    <Grid x:Name="Root" Padding="12" Background="{ThemeResource PingBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PingFontFamily}" />
                <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource PingMutedBrush}" />
                <Setter Property="Margin" Value="2,0,0,0" />
            </Style>
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{ThemeResource PingSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PingIdleBrush}" />
                <Setter Property="BorderThickness" Value="0.8" />
            </Style>
            <Style x:Key="SettingTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PingFontFamily}" />
                <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="21" />
                <Setter Property="Foreground" Value="{ThemeResource PingTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="SettingDetail" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PingFontFamily}" />
                <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource PingMutedBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="SettingToggle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>
        <TabView x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged"
            IsAddTabButtonVisible="False" TabWidthMode="SizeToContent"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabViewItem Header="일반" IsClosable="False">
                <ScrollViewer x:Name="GeneralScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel Padding="12,16" Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="앱" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid Padding="16,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="로그인 시 자동 시작" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource SettingDetail}" />
                                        <TextBlock Text="자동 시작하면 대화창을 열지 않고 트레이에서 메시지를 받습니다." Style="{StaticResource SettingDetail}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingToggle}"
                                        AutomationProperties.Name="로그인 시 자동 시작"
                                        IsEnabled="{Binding CanToggleStartup}" IsOn="{Binding IsStartupEnabled, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="알림과 화면" Style="{StaticResource GroupLabel}" />
                            <TextBlock Text="창을 닫아도 트레이에서 수신합니다. 트레이 메뉴에서 Ping을 종료하면 알림은 멈추고, 다음 실행 시 보관 기간 안의 메시지를 불러옵니다." Style="{StaticResource SettingDetail}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Grid Padding="16,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="받은 영상 바로 재생" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="상대가 보낸 영상을 알림 클릭 없이 화면에 띄웁니다." Style="{StaticResource SettingDetail}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoPlayIncomingToggle" Grid.Column="1" Style="{StaticResource SettingToggle}"
                                            AutomationProperties.Name="받은 영상 바로 재생" IsOn="{Binding AutoPlayIncoming, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Height="0.8" Margin="16,0" Background="{ThemeResource PingIdleBrush}" Opacity="0.45" />
                                    <Grid Padding="16,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="알림 소리" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="새 메시지 도착 시 Windows 기본 소리를 냅니다." Style="{StaticResource SettingDetail}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="NotificationSoundToggle" Grid.Column="1" Style="{StaticResource SettingToggle}"
                                            AutomationProperties.Name="알림 소리" IsOn="{Binding NotificationSoundEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Height="0.8" Margin="16,0" Background="{ThemeResource PingIdleBrush}" Opacity="0.45" />
                                    <Grid Padding="16,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="테마" VerticalAlignment="Center" Style="{StaticResource SettingTitle}" />
                                        <ComboBox x:Name="AppearanceComboBox" Grid.Column="1" Width="136"
                                            AutomationProperties.Name="테마" SelectedIndex="{Binding AppearanceSelection, Mode=TwoWay}">
                                            <ComboBoxItem Content="시스템" /><ComboBoxItem Content="라이트" /><ComboBoxItem Content="다크" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="프로필" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="닉네임" VerticalAlignment="Center" Style="{StaticResource SettingTitle}" />
                                        <TextBox Grid.Column="1" AutomationProperties.Name="닉네임"
                                            Text="{Binding NicknameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="저장" Click="SaveNicknameButton_Click" IsEnabled="{Binding CanSaveNickname}" />
                                    </Grid>
                                    <TextBlock Text="{Binding NicknameStatus}" Style="{StaticResource SettingDetail}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="계정" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                                <StackPanel Spacing="10" DataContext="{Binding Accounts}">
                                    <ComboBox x:Name="AccountsComboBox" AutomationProperties.Name="저장 계정" DisplayMemberPath="Label"
                                        ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" IsEnabled="{Binding CanCreate}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="SwitchAccountButton" Content="전환" Click="SwitchAccountButton_Click" IsEnabled="{Binding CanSwitch}" />
                                        <Button x:Name="CreateAccountButton" Content="새 계정 추가" Click="CreateAccountButton_Click" IsEnabled="{Binding CanCreate}" />
                                        <Button x:Name="RemoveAccountButton" Content="삭제" Click="RemoveAccountButton_Click" IsEnabled="{Binding CanRemove}" />
                                        <Button Content="새로 고침" Click="RefreshAccountsButton_Click" IsEnabled="{Binding CanCreate}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource SettingDetail}" />
                                    <ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                                <StackPanel Spacing="10" DataContext="{Binding EmailAccount}">
                                    <TextBlock Text="다른 PC에서도 같은 계정 사용" Style="{StaticResource SettingTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LinkedEmail}" Style="{StaticResource SettingDetail}" />
                                    <TextBlock Text="이 PC의 계정을 계속 쓰려면 이메일을 연결하세요. 다른 PC에서는 연결한 이메일로 로그인하면 같은 친구와 대화방을 불러옵니다." Style="{StaticResource SettingDetail}" />
                                    <TextBox Header="이메일" AutomationProperties.Name="계정 이메일" PlaceholderText="name@example.com"
                                        MaxLength="254" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditEmail}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="현재 계정에 이메일 연결" Click="LinkAccountEmailButton_Click" IsEnabled="{Binding CanLink}" />
                                        <Button Content="기존 계정 로그인" Click="EmailSignInButton_Click" IsEnabled="{Binding CanSignIn}" />
                                    </StackPanel>
                                    <TextBox Header="메일 인증번호" AutomationProperties.Name="메일 인증번호" PlaceholderText="메일에 표시된 숫자"
                                        MaxLength="10" Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCode}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding CompleteButtonText}" Click="CompleteEmailButton_Click" IsEnabled="{Binding CanVerify}" />
                                        <Button Content="번호 다시 받기" Click="ResendEmailButton_Click" IsEnabled="{Binding CanResend}" />
                                        <Button Content="취소" Click="ResetEmailButton_Click" IsEnabled="{Binding CanReset}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource SettingDetail}" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="단축키" IsClosable="False">
                <ScrollViewer x:Name="HotkeysScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel Padding="12,16" Spacing="12">
                        <TextBlock Text="단축키" Style="{StaticResource GroupLabel}" />
                        <ItemsControl x:Name="HotkeyRowsList" ItemsSource="{Binding HotkeyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander CornerRadius="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,4" Background="{ThemeResource PingBackgroundBrush}">
                                                    <TextBlock Text="{Binding DisplayShortcut}" FontSize="12" Foreground="{ThemeResource PingMutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <CheckBox Content="Ctrl" MinWidth="0" IsChecked="{Binding IsControl, Mode=TwoWay}" />
                                                <CheckBox Content="Alt" MinWidth="0" IsChecked="{Binding IsAlt, Mode=TwoWay}" />
                                                <CheckBox Content="Shift" MinWidth="0" IsChecked="{Binding IsShift, Mode=TwoWay}" />
                                                <CheckBox Content="Win" MinWidth="0" IsChecked="{Binding IsWindows, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ComboBox Width="100" AutomationProperties.Name="단축키 문자"
                                                    ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" />
                                                <Button Content="적용" Click="ApplyHotkeyButton_Click" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SettingDetail}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="행을 열어 키 조합을 변경하세요. 적용하면 전역 단축키가 바로 바뀝니다." Style="{StaticResource SettingDetail}" />
                        <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="화면+얼굴 빠른 전송" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{Binding QuickSendOffContent}" Style="{StaticResource SettingDetail}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingToggle}"
                                    AutomationProperties.Name="화면+얼굴 빠른 전송" IsOn="{Binding IsQuickSendEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="룸" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="룸" />
                    <TextBlock
                        Foreground="{ThemeResource PingMutedBrush}"
                        Text="룸 창에서 방을 만들고 친구를 초대하거나 초대 링크에 참여할 수 있어요."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="OpenRoomsButton_Click"
                        Content="룸 관리 열기" />
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="저장" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel Padding="12,16" Spacing="12">
                        <TextBlock Text="영상 보관" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid Padding="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="보낸 영상 저장" VerticalAlignment="Center" Style="{StaticResource SettingTitle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="보낸 영상 저장"
                                        IsOn="{Binding SaveSentCopy, Mode=TwoWay}" />
                                </Grid>
                                <Border Height="0.8" Margin="16,0" Background="{ThemeResource PingIdleBrush}" Opacity="0.45" />
                                <Grid Padding="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="받은 영상 자동 저장" VerticalAlignment="Center" Style="{StaticResource SettingTitle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="받은 영상 자동 저장"
                                        IsOn="{Binding SaveReceivedCopy, Mode=TwoWay}" />
                                </Grid>
                                <Border Height="0.8" Margin="16,0" Background="{ThemeResource PingIdleBrush}" Opacity="0.45" />
                                <Grid Padding="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="상대가 내 영상 저장 가능" VerticalAlignment="Center" Style="{StaticResource SettingTitle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="상대가 내 영상 저장 가능"
                                        IsOn="{Binding AllowsLocalSave, Mode=TwoWay}" />
                                </Grid>
                                <Border Height="0.8" Margin="16,0" Background="{ThemeResource PingIdleBrush}" Opacity="0.45" />
                                <Grid Padding="16,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="30일 뒤 자동 삭제" VerticalAlignment="Center" Style="{StaticResource SettingTitle}" />
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="30일 뒤 자동 삭제"
                                        IsOn="{Binding AutoDeleteAfter30Days, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="받은 영상은 상대가 허용한 영상만 저장됩니다. 끄면 전송과 재생에 필요한 임시 파일만 사용합니다."
                            Style="{StaticResource SettingDetail}" />
                        <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="저장 경로" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="{Binding ArchiveRootPath}" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True"
                                    Foreground="{ThemeResource PingMutedBrush}" FontSize="12" />
                                <Button Content="탐색기에서 열기" Click="OpenArchiveFolderButton_Click" />
                                <TextBlock Text="{Binding ArchiveFolderStatus}" Style="{StaticResource SettingDetail}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="기기" IsClosable="False">
                <ScrollViewer x:Name="DevicesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="촬영 기기" FontSize="18" FontWeight="SemiBold" />
                        <ComboBox x:Name="CameraSelectionCombo" Header="카메라" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Devices.Cameras}" DisplayMemberPath="Label" SelectedItem="{Binding Devices.SelectedCamera, Mode=TwoWay}" />
                        <ComboBox x:Name="MicrophoneSelectionCombo" Header="마이크" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Devices.Microphones}" DisplayMemberPath="Label" SelectedItem="{Binding Devices.SelectedMicrophone, Mode=TwoWay}" />
                        <Button Content="목록 새로고침" Click="RefreshDeviceListButton_Click" IsEnabled="{Binding Devices.CanRefresh}" />
                        <TextBlock Text="{Binding Devices.Status}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <TextBlock Text="진행 중인 촬영은 기존 기기를 유지합니다. 얼굴·화면+얼굴·빠른 전송·자동 회신 모두 같은 선택을 사용해요."
                            TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <TextBlock Text="iPhone · Apple Watch 추가" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding Pairing.Status}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <Border HorizontalAlignment="Center" Padding="8" Background="White" CornerRadius="16">
                            <Grid MinWidth="220" MinHeight="220">
                                <Image x:Name="PairingImage" Width="220" Height="220" Stretch="Uniform" />
                                <ProgressRing Width="40" Height="40" IsActive="{Binding Pairing.IsLoading}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="이 QR에는 로그인 세션이 들어 있습니다. 타인에게 보이지 마세요."
                            TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <Button x:Name="RefreshPairingButton" Content="QR 다시 준비" Click="RefreshPairingButton_Click" IsEnabled="{Binding Pairing.CanRetry}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="정보" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="Ping Windows" />
                    <TextBlock Foreground="{ThemeResource PingMutedBrush}" Text="Windows 11 24H2+" />
                    <StackPanel DataContext="{Binding Updates}" Spacing="10">
                        <TextBlock x:Name="InstalledVersionText" Text="{Binding CurrentVersion}" Foreground="{ThemeResource PingTextBrush}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdateButton_Click" IsEnabled="{Binding CanCheck}" />
                            <Button x:Name="InstallUpdateButton" Content="업데이트 설치" Click="InstallUpdateButton_Click" IsEnabled="{Binding CanInstall}" />
                            <Button x:Name="CancelUpdateButton" Content="취소" Click="CancelUpdateButton_Click" IsEnabled="{Binding CanCancel}" />
                        </StackPanel>
                        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
                    </StackPanel>
                    <HyperlinkButton Content="릴리즈 및 설치 안내" NavigateUri="https://github.com/0mininseoul/ping/releases" />
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
