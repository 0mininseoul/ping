<Window
    x:Class="Ping.Windows.App.Setup.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="설정">
    <Grid
        x:Name="Root"
        Padding="18"
        Background="{ThemeResource PingBackgroundBrush}">
        <TabView
            x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged"
            IsAddTabButtonVisible="False" TabWidthMode="SizeToContent"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabViewItem Header="일반" IsClosable="False">
                <ScrollViewer x:Name="GeneralScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="일반" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="닉네임"
                            Text="{Binding NicknameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Stretch"
                            Click="SaveNicknameButton_Click"
                            Content="저장"
                            IsEnabled="{Binding CanSaveNickname}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource PingMutedBrush}"
                        Text="{Binding NicknameStatus}"
                        TextWrapping="WrapWholeWords" />
                    <ToggleSwitch
                        Header="화면+얼굴 빠른 전송"
                        IsOn="{Binding IsQuickSendEnabled, Mode=TwoWay}"
                        OffContent="{Binding QuickSendOffContent}"
                        OnContent="{Binding QuickSendOnContent}" />
                    <ToggleSwitch
                        x:Name="AutoPlayIncomingToggle"
                        Header="받은 영상 자동 재생"
                        IsOn="{Binding AutoPlayIncoming, Mode=TwoWay}"
                        OffContent="알림을 눌러 재생"
                        OnContent="새로 도착한 영상 바로 재생" />
                    <ToggleSwitch
                        Header="Windows 로그인 시 자동 시작"
                        IsEnabled="{Binding CanToggleStartup}"
                        IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                        OffContent="{Binding StartupStatus}"
                        OnContent="{Binding StartupStatus}" />
                    <ToggleSwitch x:Name="NotificationSoundToggle"
                        Header="알림 소리"
                        IsOn="{Binding NotificationSoundEnabled, Mode=TwoWay}"
                        OffContent="없음" OnContent="Windows 기본 소리" />
                    <ComboBox x:Name="AppearanceComboBox" Header="화면 모드"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding AppearanceSelection, Mode=TwoWay}">
                        <ComboBoxItem Content="시스템" />
                        <ComboBoxItem Content="라이트" />
                        <ComboBoxItem Content="다크" />
                    </ComboBox>
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="단축키" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="단축키" />
                    <ListView
                        MaxHeight="310"
                        ItemsSource="{Binding HotkeyRows}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="0,8"
                                    ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource PingTextBrush}"
                                        Text="{Binding Label}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        Content="Ctrl"
                                        IsChecked="{Binding IsControl, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="2"
                                        Content="Alt"
                                        IsChecked="{Binding IsAlt, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="3"
                                        Content="Shift"
                                        IsChecked="{Binding IsShift, Mode=TwoWay}" />
                                    <CheckBox
                                        Grid.Column="4"
                                        Content="Win"
                                        IsChecked="{Binding IsWindows, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="5"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding KeyChoices}"
                                        SelectedItem="{Binding SelectedKey, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="6"
                                        HorizontalAlignment="Stretch"
                                        Click="ApplyHotkeyButton_Click"
                                        Content="적용" />
                                    <TextBlock
                                        Grid.Column="7"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource PingMutedBrush}"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Foreground="{ThemeResource PingMutedBrush}" Text="{Binding FaceHotkey}" />
                    <TextBlock Foreground="{ThemeResource PingMutedBrush}" Text="{Binding ScreenFaceHotkey}" />
                    <TextBlock Foreground="{ThemeResource PingMutedBrush}" Text="{Binding QuickSendHotkey}" />
                    <TextBlock Foreground="{ThemeResource PingMutedBrush}" Text="{Binding HistoryHotkey}" />
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="룸" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="룸" />
                    <TextBlock
                        Foreground="{ThemeResource PingMutedBrush}"
                        Text="룸 창에서 방을 만들고 친구를 초대하거나 초대 링크에 참여할 수 있어요."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="OpenRoomsButton_Click"
                        Content="룸 관리 열기" />
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="저장" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="저장" />
                    <ToggleSwitch
                        Header="보낸 영상 저장"
                        IsOn="{Binding SaveSentCopy, Mode=TwoWay}"
                        OffContent="끄기"
                        OnContent="켜기" />
                    <ToggleSwitch
                        Header="저장이 허용된 받은 영상 저장"
                        IsOn="{Binding SaveReceivedCopy, Mode=TwoWay}"
                        OffContent="끄기"
                        OnContent="켜기" />
                    <ToggleSwitch
                        Header="상대방이 내 영상 저장 허용"
                        IsOn="{Binding AllowsLocalSave, Mode=TwoWay}"
                        OffContent="끄기"
                        OnContent="켜기" />
                    <ToggleSwitch
                        Header="30일이 지난 저장 영상 자동 삭제"
                        IsOn="{Binding AutoDeleteAfter30Days, Mode=TwoWay}"
                        OffContent="끄기"
                        OnContent="켜기" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="144" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="저장 폴더"
                            IsReadOnly="True"
                            Text="{Binding ArchiveRootPath}" />
                        <Button
                            Grid.Column="1"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Stretch"
                            Click="OpenArchiveFolderButton_Click"
                            Content="탐색기에서 열기" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource PingMutedBrush}"
                        Text="보낸 영상과 받은 영상은 이 위치의 sent / received 폴더에 저장됩니다."
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource PingMutedBrush}"
                        Text="{Binding ArchiveFolderStatus}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="기기" IsClosable="False">
                <ScrollViewer x:Name="DevicesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="촬영 기기" FontSize="18" FontWeight="SemiBold" />
                        <ComboBox x:Name="CameraSelectionCombo" Header="카메라" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Devices.Cameras}" DisplayMemberPath="Label" SelectedItem="{Binding Devices.SelectedCamera, Mode=TwoWay}" />
                        <ComboBox x:Name="MicrophoneSelectionCombo" Header="마이크" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Devices.Microphones}" DisplayMemberPath="Label" SelectedItem="{Binding Devices.SelectedMicrophone, Mode=TwoWay}" />
                        <Button Content="목록 새로고침" Click="RefreshDeviceListButton_Click" IsEnabled="{Binding Devices.CanRefresh}" />
                        <TextBlock Text="{Binding Devices.Status}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <TextBlock Text="진행 중인 촬영은 기존 기기를 유지합니다. 얼굴·화면+얼굴·빠른 전송·자동 회신 모두 같은 선택을 사용해요."
                            TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <TextBlock Text="iPhone · Apple Watch 추가" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding Pairing.Status}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <Border HorizontalAlignment="Center" Padding="8" Background="White" CornerRadius="16">
                            <Grid MinWidth="220" MinHeight="220">
                                <Image x:Name="PairingImage" Width="220" Height="220" Stretch="Uniform" />
                                <ProgressRing Width="40" Height="40" IsActive="{Binding Pairing.IsLoading}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="이 QR에는 로그인 세션이 들어 있습니다. 타인에게 보이지 마세요."
                            TextWrapping="WrapWholeWords" Foreground="{ThemeResource PingMutedBrush}" />
                        <Button x:Name="RefreshPairingButton" Content="QR 다시 준비" Click="RefreshPairingButton_Click" IsEnabled="{Binding Pairing.CanRetry}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="정보" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="Ping Windows" />
                    <TextBlock Foreground="{ThemeResource PingMutedBrush}" Text="Windows 11 24H2+" />
                    <HyperlinkButton Content="릴리즈 및 설치 안내" NavigateUri="https://github.com/0mininseoul/ping/releases" />
                </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
