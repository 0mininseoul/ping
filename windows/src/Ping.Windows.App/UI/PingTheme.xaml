<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PingBackgroundBrush" Color="#F4F8FB" />
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#FDFEFF" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#182331" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#617286" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#CBD9E6" />
            <SolidColorBrush x:Key="PingAccentBrush" Color="#246EF2" />
            <SolidColorBrush x:Key="PingInputBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PingWarningFillBrush" Color="#FFF2D6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PingBackgroundBrush" Color="#0E1113" />
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#18202A" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#EEF4FC" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9AAFC2" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#334451" />
            <SolidColorBrush x:Key="PingAccentBrush" Color="#6BAEFF" />
            <SolidColorBrush x:Key="PingInputBrush" Color="#111A22" />
            <SolidColorBrush x:Key="PingWarningFillBrush" Color="#3A2C17" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PingBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PingAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PingInputBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PingWarningFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="PingTimelineItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="PingIconButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
