<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PingSurfaceBrush" Color="#D924272A" />
    <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="PingMutedTextBrush" Color="#B4BBC3" />
    <SolidColorBrush x:Key="PingBorderIdleBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="PingBorderRecordingBrush" Color="#FFFF3B30" />
    <SolidColorBrush x:Key="PingBorderFailedBrush" Color="#FFFFCC00" />
    <SolidColorBrush x:Key="PingCapsuleBrush" Color="#8C000000" />

    <CornerRadius x:Key="PingCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PingMirrorCornerRadius">100</CornerRadius>
    <x:Double x:Key="PingMirrorDiameter">200</x:Double>
    <x:Double x:Key="PingMirrorRadius">100</x:Double>
    <RectangleGeometry
        x:Key="PingScreenFaceClip"
        Rect="0,0,480,270" />
</ResourceDictionary>
