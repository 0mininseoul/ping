<Window
    x:Class="Ping.Windows.App.Capture.FaceMirrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closed="HandleClosed"
    Title="Ping">
    <Grid
        x:Name="Root"
        Width="260"
        Height="270"
        Padding="12"
        Background="Transparent"
        IsTabStop="True"
        KeyDown="HandleKeyDown"
        RowSpacing="10">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///UI/PingDesign.xaml" />
                    <ResourceDictionary Source="ms-appx:///UI/RainbowBorder.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="MirrorBorder"
            Width="{StaticResource PingMirrorDiameter}"
            Height="{StaticResource PingMirrorDiameter}"
            HorizontalAlignment="Center"
            Background="{StaticResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingBorderIdleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PingMirrorCornerRadius}">
            <Grid Clip="{StaticResource PingMirrorClip}">
                <MediaPlayerElement
                    x:Name="PreviewElement"
                    AreTransportControlsEnabled="False"
                    Stretch="UniformToFill" />
                <MediaPlayerElement
                    x:Name="ReviewElement"
                    AreTransportControlsEnabled="False"
                    Stretch="UniformToFill"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="PreviewPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding StateText}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PingMutedTextBrush}"
                        Text="Preview" />
                </StackPanel>
                <Border
                    Width="34"
                    Height="34"
                    Margin="0,12,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#CCFF3B30"
                    BorderBrush="{StaticResource PingBorderRecordingBrush}"
                    BorderThickness="1"
                    CornerRadius="17"
                    Opacity="{Binding RecordingCountdownOpacity}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding RecordingCountdownText}" />
                </Border>
            </Grid>
        </Border>

        <Border
            x:Name="PartnerChip"
            Grid.Row="1"
            HorizontalAlignment="Center"
            Padding="12,5"
            Background="{StaticResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingBorderIdleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PingCornerRadius}"
            IsTapEnabled="True"
            Tapped="PartnerChip_Tapped">
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource PingTextBrush}"
                Text="{Binding PartnerLabel}" />
        </Border>

        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="{StaticResource PingMutedTextBrush}"
            Text="{Binding StatusMessage}"
            TextAlignment="Center"
            TextWrapping="WrapWholeWords" />
    </Grid>
</Window>
