<Window
    x:Class="Ping.Windows.App.Capture.QuickSendHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping">
    <Grid
        x:Name="Root"
        Width="260"
        Height="116"
        Padding="10"
        Background="Transparent"
        IsTabStop="True"
        KeyDown="HandleKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///UI/PingDesign.xaml" />
                    <ResourceDictionary Source="ms-appx:///UI/RainbowBorder.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border
            x:Name="HudBorder"
            Padding="12"
            Background="{StaticResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingBorderIdleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PingCornerRadius}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="44"
                    Height="44"
                    Background="#22FF3B30"
                    BorderBrush="{StaticResource PingBorderRecordingBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Opacity="{Binding RecordingCountdownOpacity}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding RecordingCountdownText}" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding ModeLabel}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource PingMutedTextBrush}"
                        Text="{Binding RoomName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource PingMutedTextBrush}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
