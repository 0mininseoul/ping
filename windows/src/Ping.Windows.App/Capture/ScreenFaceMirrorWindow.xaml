<Window
    x:Class="Ping.Windows.App.Capture.ScreenFaceMirrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closed="HandleClosed"
    Title="Ping">
    <Grid
        x:Name="Root"
        Background="Transparent"
        IsTabStop="True"
        KeyDown="HandleKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///UI/PingDesign.xaml" />
                    <ResourceDictionary Source="ms-appx:///UI/RainbowBorder.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border
            x:Name="MirrorBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingBorderIdleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PingCornerRadius}">
            <Grid>
                <Rectangle
                    Fill="#182024"
                    RadiusX="16"
                    RadiusY="16" />
                <Image
                    Source="{Binding ScreenPreviewUri}"
                    Stretch="UniformToFill" />
                <Image x:Name="RecordingPreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                <MediaPlayerElement
                    x:Name="ReviewElement"
                    AreTransportControlsEnabled="False"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="ScreenPreviewPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="{Binding StateText}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource PingMutedTextBrush}"
                        Text="화면과 얼굴" />
                </StackPanel>

                <Border
                    x:Name="HintCapsule"
                    Margin="0,14,0,0"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource PingCapsuleBrush}"
                    CornerRadius="12"
                    Opacity="{Binding HintOpacity}">
                    <TextBlock
                        x:Name="HintLabel"
                        ToolTipService.ToolTip="{Binding StatusMessage}"
                        MaxWidth="360"
                        FontSize="11"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="{Binding HintText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Border>

                <Border
                    Margin="12,48,12,0"
                    Padding="8,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource PingCapsuleBrush}"
                    CornerRadius="10"
                    Opacity="{Binding ViewportGuideOpacity}">
                    <TextBlock
                        x:Name="ViewportGuideLabel"
                        FontSize="10"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="{Binding ViewportGuideText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="Alt+휠 또는 지원되는 두 손가락 확대 제스처로 조정해요. Alt를 누르고 포인터를 움직이면 해당 위치를 따라가요. Alt+0으로 전체 화면으로 돌아가요." />
                </Border>

                <Border
                    x:Name="FacePreviewBubble"
                    Width="82"
                    Height="82"
                    Margin="0,0,14,14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#3324272A"
                    BorderBrush="{StaticResource PingBorderIdleBrush}"
                    BorderThickness="0"
                    CornerRadius="41">
                    <Grid>
                        <MediaPlayerElement
                            x:Name="FacePreviewElement"
                            AreTransportControlsEnabled="False"
                            Stretch="UniformToFill" />
                        <TextBlock
                            x:Name="FacePreviewPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource PingMutedTextBrush}"
                            Text="카메라" />
                    </Grid>
                </Border>

                <Border
                    Width="34"
                    Height="34"
                    Margin="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#CCFF3B30"
                    BorderBrush="{StaticResource PingBorderRecordingBrush}"
                    BorderThickness="1"
                    CornerRadius="17"
                    Opacity="{Binding RecordingCountdownOpacity}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="{Binding RecordingCountdownText}" />
                </Border>

                <Border
                    x:Name="PartnerChip"
                    Margin="0,0,0,12"
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource PingSurfaceBrush}"
                    BorderBrush="{StaticResource PingBorderIdleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PingCornerRadius}"
                    IsTapEnabled="True"
                    Tapped="PartnerChip_Tapped">
                    <TextBlock
                        x:Name="PartnerLabelElement"
                        MaxWidth="260"
                        FontSize="12"
                        Foreground="{ThemeResource PingTextBrush}"
                        Text="{Binding PartnerLabel}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
