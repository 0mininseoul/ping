<Window
    x:Class="Ping.Windows.App.Capture.ScreenFaceMirrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closed="HandleClosed"
    Title="Ping">
    <Grid
        x:Name="Root"
        Width="508"
        Height="298"
        Padding="14"
        Background="Transparent"
        IsTabStop="True"
        KeyDown="HandleKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///UI/PingDesign.xaml" />
                    <ResourceDictionary Source="ms-appx:///UI/RainbowBorder.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border
            x:Name="MirrorBorder"
            Width="480"
            Height="270"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingBorderIdleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PingCornerRadius}">
            <Grid Clip="{StaticResource PingScreenFaceClip}">
                <Rectangle
                    Fill="#182024"
                    RadiusX="16"
                    RadiusY="16" />
                <Image
                    Source="{Binding ScreenPreviewUri}"
                    Stretch="UniformToFill" />
                <MediaPlayerElement
                    x:Name="ReviewElement"
                    AreTransportControlsEnabled="False"
                    Stretch="UniformToFill"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="ScreenPreviewPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding StateText}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource PingMutedTextBrush}"
                        Text="Screen+Face" />
                </StackPanel>

                <Border
                    x:Name="HintCapsule"
                    Margin="0,14,0,0"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource PingCapsuleBrush}"
                    CornerRadius="12"
                    Opacity="{Binding HintOpacity}">
                    <TextBlock
                        MaxWidth="360"
                        FontSize="11"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding HintText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Border>

                <Border
                    x:Name="FacePreviewBubble"
                    Width="82"
                    Height="82"
                    Margin="0,0,14,14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#3324272A"
                    BorderBrush="{StaticResource PingBorderIdleBrush}"
                    BorderThickness="1"
                    CornerRadius="41">
                    <Grid Clip="{StaticResource PingFaceBubbleClip}">
                        <MediaPlayerElement
                            x:Name="FacePreviewElement"
                            AreTransportControlsEnabled="False"
                            Stretch="UniformToFill" />
                        <TextBlock
                            x:Name="FacePreviewPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource PingMutedTextBrush}"
                            Text="Camera" />
                    </Grid>
                </Border>

                <Border
                    Width="34"
                    Height="34"
                    Margin="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#CCFF3B30"
                    BorderBrush="{StaticResource PingBorderRecordingBrush}"
                    BorderThickness="1"
                    CornerRadius="17"
                    Opacity="{Binding RecordingCountdownOpacity}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding RecordingCountdownText}" />
                </Border>

                <Border
                    x:Name="PartnerChip"
                    Margin="0,0,0,12"
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource PingSurfaceBrush}"
                    BorderBrush="{StaticResource PingBorderIdleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PingCornerRadius}"
                    IsTapEnabled="True"
                    Tapped="PartnerChip_Tapped">
                    <TextBlock
                        MaxWidth="260"
                        FontSize="12"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="{Binding PartnerLabel}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
