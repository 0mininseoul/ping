<Window
    x:Class="Ping.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping">
    <Grid
        x:Name="Root"
        Width="420"
        MinHeight="520"
        Padding="18"
        Background="#121314"
        RowSpacing="14">
        <Grid.Resources>
            <SolidColorBrush x:Key="PingBackgroundBrush" Color="#121314" />
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#24272A" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9DA3AA" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="PingWarningBrush" Color="#FFFFCC00" />
            <SolidColorBrush x:Key="PingRedBrush" Color="#FFFF3B30" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="ShellTitle"
                    x:FieldModifier="public"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="Ping" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource PingMutedBrush}"
                    Text="Windows tray and hotkeys" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Padding="10,5"
                Background="{StaticResource PingSurfaceBrush}"
                BorderBrush="{StaticResource PingIdleBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <TextBlock
                    x:Name="StateBadge"
                    x:FieldModifier="public"
                    FontSize="12"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="History" />
            </Border>
        </Grid>

        <Border
            x:Name="StateBorder"
            x:FieldModifier="public"
            Grid.Row="1"
            Padding="16"
            Background="{StaticResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingIdleBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="StateTitle"
                        x:FieldModifier="public"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="Rooms and recent pings" />
                    <TextBlock
                        x:Name="StateDetail"
                        x:FieldModifier="public"
                        FontSize="13"
                        Foreground="{StaticResource PingMutedBrush}"
                        TextWrapping="WrapWholeWords"
                        Text="Ping is running from the tray." />
                </StackPanel>

                <StackPanel
                    x:Name="HistoryPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Spacing="10">
                    <Border
                        Padding="12"
                        Background="#1AFFFFFF"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="5">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Ping is ready" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource PingMutedBrush}"
                                Text="Rooms and recent activity are ready."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="12"
                        Background="#1AFFFFFF"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="5">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Hotkeys" />
                            <TextBlock
                                x:Name="HotkeyState"
                                x:FieldModifier="public"
                                FontSize="12"
                                Foreground="{StaticResource PingMutedBrush}"
                                Text="Registering global hotkeys..."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border
                    x:Name="BlockedPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Padding="14"
                    Background="#22FFCC00"
                    BorderBrush="{StaticResource PingWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="Command reached Ping" />
                        <TextBlock
                            x:Name="BlockedReason"
                            x:FieldModifier="public"
                            FontSize="12"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="The command could not continue."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="SettingsPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Spacing="12"
                    Visibility="Collapsed">
                    <ToggleSwitch
                        x:Name="QuickSendToggle"
                        Header="화면+얼굴 빠른 전송 사용"
                        OffContent="미러 먼저 열기"
                        OnContent="즉시 녹화/전송"
                        Toggled="HandleQuickSendToggleToggled" />

                    <Border
                        Padding="12"
                        Background="#1AFFFFFF"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="5">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Default room" />
                            <TextBlock
                                x:Name="QuickSendDefaultRoom"
                                FontSize="12"
                                Foreground="{StaticResource PingMutedBrush}"
                                Text="No sendable default room"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource PingMutedBrush}"
                Text="Tray icon active" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6">
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource PingIdleBrush}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource PingMutedBrush}"
                    Text="Ready" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
