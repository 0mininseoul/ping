<Window
    x:Class="Ping.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping">
    <Grid
        x:Name="Root"
        MinWidth="720"
        MinHeight="520"
        Padding="18"
        Background="#121314"
        RowSpacing="14">
        <Grid.Resources>
            <SolidColorBrush x:Key="PingBackgroundBrush" Color="#121314" />
            <SolidColorBrush x:Key="PingSurfaceBrush" Color="#24272A" />
            <SolidColorBrush x:Key="PingMutedBrush" Color="#9DA3AA" />
            <SolidColorBrush x:Key="PingTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PingIdleBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="PingWarningBrush" Color="#FFFFCC00" />
            <SolidColorBrush x:Key="PingRedBrush" Color="#FFFF3B30" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="ShellTitle"
                    x:FieldModifier="public"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="Ping" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource PingMutedBrush}"
                    Text="Rooms, messages, and quick pings" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Padding="10,5"
                Background="{StaticResource PingSurfaceBrush}"
                BorderBrush="{StaticResource PingIdleBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <TextBlock
                    x:Name="StateBadge"
                    x:FieldModifier="public"
                    FontSize="12"
                    Foreground="{StaticResource PingTextBrush}"
                    Text="Rooms" />
            </Border>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="8"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="HandleOpenRoomsClicked"
                Content="Create / Join room" />
            <Button
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="HandleOpenHistoryClicked"
                Content="History" />
            <Button
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="HandleNewPingClicked"
                Content="New face ping" />
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="HandleOpenSettingsClicked"
                Content="Settings" />
        </Grid>

        <Border
            x:Name="StateBorder"
            x:FieldModifier="public"
            Grid.Row="2"
            Padding="16"
            Background="{StaticResource PingSurfaceBrush}"
            BorderBrush="{StaticResource PingIdleBrush}"
            BorderThickness="1"
            CornerRadius="18">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="StateTitle"
                        x:FieldModifier="public"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PingTextBrush}"
                        Text="Recent conversations" />
                    <TextBlock
                        x:Name="StateDetail"
                        x:FieldModifier="public"
                        FontSize="13"
                        Foreground="{StaticResource PingMutedBrush}"
                        TextWrapping="WrapWholeWords"
                        Text="Open a room to continue the conversation or send a new ping." />
                </StackPanel>

                <Grid
                    x:Name="MessengerHomeShell"
                    Grid.Row="1"
                    ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="HistoryPanel"
                        x:FieldModifier="public"
                        Spacing="10">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="Rooms" />
                        <Border
                            x:Name="HomeRoomsList"
                            MinHeight="210"
                            Padding="12"
                            Background="#1AFFFFFF"
                            BorderBrush="{StaticResource PingIdleBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{StaticResource PingTextBrush}"
                                    Text="Open History to view synced rooms" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource PingMutedBrush}"
                                    Text="Recent rooms and unread messages appear in the conversation window."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            x:Name="HotkeyState"
                            x:FieldModifier="public"
                            FontSize="12"
                            Foreground="{StaticResource PingMutedBrush}"
                            Text="Registering global hotkeys..."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Border
                        x:Name="SelectedRoomPreview"
                        Grid.Column="1"
                        Padding="14"
                        Background="#1AFFFFFF"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Choose a conversation" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource PingMutedBrush}"
                                Text="Messages, video pings, reactions, and replies are handled in the room timeline."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    x:Name="BlockedPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Padding="14"
                    Background="#22FFCC00"
                    BorderBrush="{StaticResource PingWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="Command reached Ping" />
                        <TextBlock
                            x:Name="BlockedReason"
                            x:FieldModifier="public"
                            FontSize="12"
                            Foreground="{StaticResource PingTextBrush}"
                            Text="The command could not continue."
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Name="BlockedRetryButton"
                            x:FieldModifier="public"
                            HorizontalAlignment="Left"
                            Click="HandleBlockedRetryClicked"
                            Content="다시 시도"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="SettingsPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Spacing="12"
                    Visibility="Collapsed">
                    <ToggleSwitch
                        x:Name="QuickSendToggle"
                        Header="화면+얼굴 빠른 전송 사용"
                        OffContent="미러 먼저 열기"
                        OnContent="즉시 녹화/전송"
                        Toggled="HandleQuickSendToggleToggled" />

                    <Border
                        Padding="12"
                        Background="#1AFFFFFF"
                        BorderBrush="{StaticResource PingIdleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="5">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PingTextBrush}"
                                Text="Default room" />
                            <TextBlock
                                x:Name="QuickSendDefaultRoom"
                                FontSize="12"
                                Foreground="{StaticResource PingMutedBrush}"
                                Text="No sendable default room"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{StaticResource PingMutedBrush}"
                Text="Background sync active" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{StaticResource PingMutedBrush}"
                Text="Ready" />
        </Grid>
    </Grid>
</Window>
