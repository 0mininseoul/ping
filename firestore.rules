rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOpenRoomJoin() {
      return resource.data.status == "open"
             && !(request.auth.uid in resource.data.memberUids)
             && resource.data.memberUids.size() == 1
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["memberUids", "memberNicknames", "status"])
             && request.resource.data.memberUids.size() == 2
             && request.resource.data.memberUids.hasAll(resource.data.memberUids)
             && request.resource.data.memberUids.hasAll([request.auth.uid])
             && request.resource.data.status == "full"
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .addedKeys().hasOnly([request.auth.uid])
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .addedKeys().hasAll([request.auth.uid])
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .changedKeys().size() == 0
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .removedKeys().size() == 0
             && request.resource.data.memberNicknames[request.auth.uid] is string;
    }

    function preservesRoomIdentity() {
      return request.resource.data.ownerUid == resource.data.ownerUid
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isOwnerRename() {
      return request.auth.uid == resource.data.ownerUid
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["name", "searchableName"])
             && request.resource.data.name is string
             && request.resource.data.searchableName is string;
    }

    function isMemberLeave() {
      return request.auth.uid in resource.data.memberUids
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["memberUids", "memberNicknames", "status"])
             && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
             && resource.data.memberUids.hasAll(request.resource.data.memberUids)
             && !(request.auth.uid in request.resource.data.memberUids)
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .removedKeys().hasOnly([request.auth.uid])
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .addedKeys().size() == 0
             && request.resource.data.memberNicknames.diff(resource.data.memberNicknames)
                .changedKeys().size() == 0
             && request.resource.data.status == "open";
    }

    function roomForMessage() {
      return get(/databases/$(db)/documents/rooms/$(request.resource.data.roomId));
    }

    function videoExpiresAt() {
      return request.time + duration.value(30, 'h');
    }

    function invitationExpiresAt() {
      return request.time + duration.value(8, 'd');
    }

    function isFirestoreVideoRef() {
      return request.resource.data.videoUrl.matches(
        "^firestore-chunks://"
        + request.auth.uid
        + "/"
        + request.resource.data.videoId
        + "$"
      );
    }

    function videoForMessage() {
      return get(/databases/$(db)/documents/videoChunks/$(request.resource.data.videoId));
    }

    function messageVideoManifestMatches() {
      return videoForMessage().data.ownerUid == request.resource.data.senderUid
             && request.resource.data.receiverUid in videoForMessage().data.authorizedUids
             && request.resource.data.senderUid in videoForMessage().data.authorizedUids
             && videoForMessage().data.contentType == "video/mp4"
             && videoForMessage().data.expiresAt == request.resource.data.expiresAt
             && videoForMessage().data.expiresAt > request.time;
    }

    function isValidMessageCreate() {
      return request.resource.data.keys().hasOnly([
               "roomId", "senderUid", "receiverUid", "senderNickname", "videoId", "videoUrl",
               "durationMs", "mirrorPosition", "status", "createdAt", "expiresAt"
             ])
             && request.auth.uid == request.resource.data.senderUid
             && request.resource.data.status == "uploaded"
             && request.resource.data.durationMs == 2000
             && request.resource.data.senderNickname is string
             && request.resource.data.videoId is string
             && request.resource.data.videoId.matches("^[A-Za-z0-9-]+$")
             && request.resource.data.videoUrl is string
             && isFirestoreVideoRef()
             && messageVideoManifestMatches()
             && request.resource.data.createdAt is timestamp
             && request.resource.data.createdAt == request.time
             && request.resource.data.expiresAt is timestamp
             && request.resource.data.expiresAt > request.time
             && request.resource.data.expiresAt <= videoExpiresAt()
             && request.resource.data.mirrorPosition.keys().hasOnly(["xRatio", "yRatio"])
             && request.resource.data.mirrorPosition.xRatio is number
             && request.resource.data.mirrorPosition.yRatio is number
             && request.resource.data.mirrorPosition.xRatio >= 0
             && request.resource.data.mirrorPosition.xRatio <= 1
             && request.resource.data.mirrorPosition.yRatio >= 0
             && request.resource.data.mirrorPosition.yRatio <= 1
             && request.resource.data.roomId is string
             && request.resource.data.receiverUid is string
             && roomForMessage().data.status == "full"
             && request.resource.data.senderUid in roomForMessage().data.memberUids
             && request.resource.data.receiverUid in roomForMessage().data.memberUids
             && request.resource.data.senderUid != request.resource.data.receiverUid;
    }

    function isValidInvitationCreate() {
      return request.resource.data.keys().hasOnly([
               "fromUid", "toUid", "roomId", "fromNickname", "roomName",
               "createdAt", "expiresAt"
             ])
             && request.auth.uid == request.resource.data.fromUid
             && request.resource.data.toUid is string
             && request.resource.data.toUid != request.auth.uid
             && request.resource.data.roomId is string
             && request.resource.data.fromNickname is string
             && request.resource.data.roomName is string
             && request.resource.data.createdAt is timestamp
             && request.resource.data.createdAt == request.time
             && request.resource.data.expiresAt is timestamp
             && request.resource.data.expiresAt > request.time
             && request.resource.data.expiresAt <= invitationExpiresAt();
    }

    function isValidVideoManifestCreate() {
      return request.resource.data.keys().hasOnly([
               "ownerUid", "authorizedUids", "chunkCount", "byteCount",
               "contentType", "createdAt", "expiresAt"
             ])
             && request.auth.uid == request.resource.data.ownerUid
             && request.resource.data.authorizedUids is list
             && request.auth.uid in request.resource.data.authorizedUids
             && request.resource.data.authorizedUids.size() >= 2
             && request.resource.data.authorizedUids.size() <= 10
             && request.resource.data.chunkCount is int
             && request.resource.data.chunkCount > 0
             && request.resource.data.chunkCount <= 32
             && request.resource.data.byteCount is int
             && request.resource.data.byteCount > 0
             && request.resource.data.byteCount <= 16 * 1024 * 1024
             && request.resource.data.contentType == "video/mp4"
             && request.resource.data.createdAt is timestamp
             && request.resource.data.createdAt == request.time
             && request.resource.data.expiresAt is timestamp
             && request.resource.data.expiresAt > request.time
             && request.resource.data.expiresAt <= videoExpiresAt();
    }

    function chunkIdMatchesIndex(chunkId) {
      return (chunkId == "0000" && request.resource.data.index == 0)
             || (chunkId == "0001" && request.resource.data.index == 1)
             || (chunkId == "0002" && request.resource.data.index == 2)
             || (chunkId == "0003" && request.resource.data.index == 3)
             || (chunkId == "0004" && request.resource.data.index == 4)
             || (chunkId == "0005" && request.resource.data.index == 5)
             || (chunkId == "0006" && request.resource.data.index == 6)
             || (chunkId == "0007" && request.resource.data.index == 7)
             || (chunkId == "0008" && request.resource.data.index == 8)
             || (chunkId == "0009" && request.resource.data.index == 9)
             || (chunkId == "0010" && request.resource.data.index == 10)
             || (chunkId == "0011" && request.resource.data.index == 11)
             || (chunkId == "0012" && request.resource.data.index == 12)
             || (chunkId == "0013" && request.resource.data.index == 13)
             || (chunkId == "0014" && request.resource.data.index == 14)
             || (chunkId == "0015" && request.resource.data.index == 15)
             || (chunkId == "0016" && request.resource.data.index == 16)
             || (chunkId == "0017" && request.resource.data.index == 17)
             || (chunkId == "0018" && request.resource.data.index == 18)
             || (chunkId == "0019" && request.resource.data.index == 19)
             || (chunkId == "0020" && request.resource.data.index == 20)
             || (chunkId == "0021" && request.resource.data.index == 21)
             || (chunkId == "0022" && request.resource.data.index == 22)
             || (chunkId == "0023" && request.resource.data.index == 23)
             || (chunkId == "0024" && request.resource.data.index == 24)
             || (chunkId == "0025" && request.resource.data.index == 25)
             || (chunkId == "0026" && request.resource.data.index == 26)
             || (chunkId == "0027" && request.resource.data.index == 27)
             || (chunkId == "0028" && request.resource.data.index == 28)
             || (chunkId == "0029" && request.resource.data.index == 29)
             || (chunkId == "0030" && request.resource.data.index == 30)
             || (chunkId == "0031" && request.resource.data.index == 31);
    }

    function isValidVideoChunkCreate(videoId, chunkId) {
      return request.resource.data.keys().hasOnly([
               "ownerUid", "authorizedUids", "index", "data", "createdAt", "expiresAt"
             ])
             && request.auth.uid == get(/databases/$(db)/documents/videoChunks/$(videoId)).data.ownerUid
             && request.resource.data.ownerUid == request.auth.uid
             && request.resource.data.authorizedUids == get(/databases/$(db)/documents/videoChunks/$(videoId)).data.authorizedUids
             && request.resource.data.index is int
             && request.resource.data.index >= 0
             && request.resource.data.index < get(/databases/$(db)/documents/videoChunks/$(videoId)).data.chunkCount
             && chunkIdMatchesIndex(chunkId)
             && request.resource.data.data is string
             && request.resource.data.data.size() < 800 * 1024
             && request.resource.data.createdAt is timestamp
             && request.resource.data.createdAt == request.time
             && request.resource.data.expiresAt is timestamp
             && request.resource.data.expiresAt == get(/databases/$(db)/documents/videoChunks/$(videoId)).data.expiresAt
             && request.resource.data.expiresAt > request.time;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read: if signedIn()
                  && (resource.data.status == "open"
                      || request.auth.uid in resource.data.memberUids);
      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.memberUids.size() == 1;
      allow update: if signedIn()
                    && preservesRoomIdentity()
                    && ((isOwnerRename() || isMemberLeave())
                        || isOpenRoomJoin());
    }

    match /messages/{messageId} {
      allow read: if signedIn()
                  && request.auth.uid in [resource.data.senderUid, resource.data.receiverUid]
                  && resource.data.expiresAt > request.time;
      allow create: if signedIn()
                    && isValidMessageCreate();
      allow update: if signedIn()
                    && request.auth.uid == resource.data.receiverUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
                    && request.resource.data.status == "seen";
      allow delete: if signedIn()
                    && request.auth.uid in [resource.data.senderUid, resource.data.receiverUid]
                    && resource.data.expiresAt < request.time;
    }

    match /invitations/{inviteId} {
      allow read: if signedIn()
                  && request.auth.uid == resource.data.toUid
                  && resource.data.expiresAt > request.time;
      allow delete: if signedIn()
                    && (request.auth.uid == resource.data.toUid
                        || (request.auth.uid == resource.data.fromUid
                            && resource.data.expiresAt < request.time));
      allow create: if signedIn() && isValidInvitationCreate();
    }

    match /videoChunks/{videoId} {
      allow read: if signedIn()
                  && (request.auth.uid == resource.data.ownerUid
                      || request.auth.uid in resource.data.authorizedUids)
                  && resource.data.expiresAt > request.time;
      allow create: if signedIn()
                    && isValidVideoManifestCreate();
      allow delete: if signedIn()
                    && request.auth.uid in resource.data.authorizedUids
                    && resource.data.expiresAt < request.time;

      match /chunks/{chunkId} {
        allow read: if signedIn()
                    && request.auth.uid in resource.data.authorizedUids
                    && resource.data.expiresAt > request.time;
        allow create: if signedIn()
                      && isValidVideoChunkCreate(videoId, chunkId);
        allow delete: if signedIn()
                      && request.auth.uid in resource.data.authorizedUids
                      && resource.data.expiresAt < request.time;
      }
    }
  }
}
